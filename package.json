{
  "name": "pathwright",
  "version": "4.1.0",
  "description": "Self-hosted DevOps learning app with an AI tutor: a 7-month roadmap, full lessons, hands-on workshops, quizzes and month projects. Node.js + Express + DeepSeek.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/app.test.js"
  },
  "keywords": [
    "devops",
    "ai",
    "tutor",
    "learning",
    "roadmap",
    "deepseek",
    "llm",
    "express",
    "linux",
    "docker",
    "kubernetes",
    "ci-cd",
    "self-hosted"
  ],
  "author": "Aleksandr Shchurov (Qatrol)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Qatrol/pathwright.git"
  },
  "homepage": "https://github.com/Qatrol/pathwright#readme",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  }
}
