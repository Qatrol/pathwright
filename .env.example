# Скопируйте этот файл в .env и вставьте свои значения.
# .env в репозиторий не попадает — он в .gitignore.

# Ключ DeepSeek API (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=your_key_here

# Порт, на котором поднимается сервер
PORT=5555

# Интерфейс, который слушает сервер.
# 127.0.0.1 — только этот компьютер (безопасно по умолчанию).
# 0.0.0.0 — доступ из сети/Docker; ставьте reverse-proxy с авторизацией.
# HOST=127.0.0.1

# Каталог данных (по умолчанию ./storage). Удобно для Docker и бэкапов.
# STORAGE_DIR=./storage

# Необязательно: модель и профиль ученика
# DEEPSEEK_MODEL=deepseek-v4-flash
# STUDENT_PROFILE=20 лет, начинающий сисадмин, учу Linux и Docker
