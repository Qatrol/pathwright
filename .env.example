# Скопируйте этот файл в .env и вставьте свои значения.
# .env в репозиторий не попадает — он в .gitignore.

# Ключ DeepSeek API (https://platform.deepseek.com/api_keys)
# Один на весь сервер: пользователи его не видят.
DEEPSEEK_API_KEY=your_key_here

# Порт, на котором поднимается сервер
PORT=5555

# Интерфейс, который слушает сервер.
# 127.0.0.1 — только этот компьютер (безопасно по умолчанию).
# 0.0.0.0 — доступ из сети/Docker; ставьте reverse-proxy с TLS.
# HOST=127.0.0.1

# Каталог данных (по умолчанию ./storage). Удобно для Docker и бэкапов.
# STORAGE_DIR=./storage

# --- Аккаунты и подписки ---

# Длина пробного периода в днях. 0 — выключить пробный период.
# TRIAL_DAYS=7

# Закрыть регистрацию (только для приглашённых).
# REGISTRATION_OPEN=false

# Сколько новых аккаунтов в час можно создать с одного адреса.
# REGISTRATION_LIMIT=5

# Часовой пояс сброса дневного лимита генераций.
# TIMEZONE=Europe/Moscow

# Первые пользователи с этими email получают роль admin (через запятую).
# ADMIN_EMAILS=you@example.com

# Кука Secure отправляется только по HTTPS.
# Включайте, когда сайт открыт через TLS/reverse-proxy.
# COOKIE_SECURE=true

# За reverse-proxy (nginx, Caddy): доверять X-Forwarded-For/Proto.
# TRUST_PROXY=true

# --- Оплата ---

# Заглушка: счёт создаётся, оплата подтверждается кнопкой в кабинете.
# Когда подключите провайдера — PAYMENT_STUB=false.
# PAYMENT_STUB=true

# Публичный адрес сайта: нужен провайдеру для возврата после оплаты.
# PUBLIC_BASE_URL=https://pathwright.example.com

# Необязательно: модель и профиль ученика
# DEEPSEEK_MODEL=deepseek-v4-flash
# STUDENT_PROFILE=20 лет, начинающий сисадмин, учу Linux и Docker
